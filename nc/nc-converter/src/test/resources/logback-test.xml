<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5level %-50logger{1} | %msg%n</pattern>
        </encoder>
    </appender>

    <root level="error">
        <appender-ref ref="STDOUT"/>
    </root>

    <!-- Log NC queries after the RDF context has been inserted. -->
    <logger name="com.powsybl.nc.model.triplestore.NcQueryExecutor" level="debug"/>
</configuration>
